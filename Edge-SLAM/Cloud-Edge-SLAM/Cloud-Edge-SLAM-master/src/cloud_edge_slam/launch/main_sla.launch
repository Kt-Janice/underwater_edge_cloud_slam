<launch>
    <arg name="runtime_environment" default="sea"/>
    <arg name="setting_path" default="$(find cloud_edge_slam)/config/davis.yaml"/>
    <arg name="data_type" default="bag"/>
    <arg name="data_path" default="/media/lhf/T7 Shield/Dataset/水下数据集/AquaticVision(港中深）/04_loop/data rosbag/Loop1_with_board_imu_200hz_images_20hz.bag"/>
    <arg name="result_path" default="/home/lhf/vc-SLAM_ws/Edge-SLAM/Cloud-Edge-SLAM/Cloud-Edge-SLAM-master/src/cloud_edge_slam/results"/>

    <param name="/use_sim_time" value="true"/>

    <!--
      This node intentionally preserves the active main_lhf.launch sea template:
      DAVIS remaps, its image topic, UDF settings, sampler settings, and RViz
      remain present for every environment.  LAND and AIR callers must override
      their own dataset arguments; they must not treat these sea defaults as a
      land/air configuration.
    -->
    <node name="cloud_edge_slam" pkg="cloud_edge_slam"
          type="cloud_edge_slam_node" required="true" output="screen">
        <param name="runtime_environment" value="$(arg runtime_environment)"/>
        <param name="vocabulary_path" value="$(find cloud_edge_slam)/Vocabulary/ORBvoc.txt"/>
        <remap from="/camera0" to="/davis_left/image_raw"/>
        <remap from="/imu" to="/davis_left/imu"/>
        <remap from="/camera/rgb/image_color" to="/davis_left/image_raw"/>
        <param name="raw_image_topic" value="/davis_left/image_raw"/>
        <param name="setting_path" value="$(arg setting_path)"/>
        <param name="data_type" value="$(arg data_type)"/>
        <param name="data_path" value="$(arg data_path)"/>
        <param name="result_path" value="$(arg result_path)"/>
        <param name="cloud_topic_name" value="/cloud_slam"/>
        <param name="merge_anyway" value="false"/>
        <param name="cloud_online" value="true"/>
        <param name="real_online" value="true"/>
        <param name="cloud_merge" value="true"/>
        <param name="save_cloud_bag" value="false"/>
        <param name="wait_cloud_result" value="true"/>
        <param name="main_loop_sleep_ms" value="30"/>
        <param name="sampler_edge_front_kf_num" value="40"/>
        <param name="sampler_edge_back_kf_num" value="40"/>
        <param name="sampler_edge_front_min_time" value="3.0"/>
        <param name="sampler_edge_back_min_time" value="3.0"/>
        <param name="sampler_pd_kp" value="0.8"/>
        <param name="sampler_pd_kd" value="0.08"/>
        <param name="sampler_pd_th" value="12"/>
        <param name="old_udf_cloud_edge" value="false"/>
        <param name="new_udf_cloud_edge" value="true"/>
        <param name="kf_culling" value="false"/>
        <param name="stitch_trajectories" value="true"/>
    </node>

    <node name="rviz" pkg="rviz" type="rviz"
          args="-d $(find cloud_edge_slam)/config/rviz_svin.rviz"/>
</launch>
